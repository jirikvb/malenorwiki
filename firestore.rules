rules_version = '2';
// Pravidla databáze MalenorWiki.
// Vlož celý tento soubor do Firebase konzole: Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // ID vypravěčů – stejný seznam jako v site-config.js
    function isAdmin() { return signedIn() && me() in ['XTzKUDtsVRR6LBmcMUsC5F8b4iO2']; }
    function isMember() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/members/$(me())));
    }

    // Schválení členové. Zapisuje jen vypravěč.
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow write: if isAdmin();
    }

    // Žádosti o přístup. Každý si může založit jen svou.
    match /requests/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'createdAt']);
      allow delete: if isAdmin();
    }

    // Veřejné profily (jméno a fotka) pro členy.
    match /users/{uid} {
      allow read: if isMember();
      allow write: if isMember() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'updatedAt']);
    }

    // Články a jejich starší verze. Číst smí členové, zapisovat vypravěč.
    match /articles/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
      match /revisions/{rev} {
        allow read: if isMember();
        allow write: if isAdmin();
      }
    }

    // Návrhy úprav.
    match /proposals/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.author == me()
        && request.resource.data.status == 'open'
        && request.resource.data.type in ['edit', 'new'];
      allow update: if isAdmin() || (isMember()
        && resource.data.author == me()
        && resource.data.status == 'open'
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['author', 'authorName', 'status', 'type', 'articleId', 'createdAt', 'decidedAt', 'decidedBy', 'decisionNote']));
      allow delete: if isAdmin() || (isMember()
        && resource.data.author == me()
        && resource.data.status == 'open');
    }

    // Deníky postav. Vypravěč vidí a upravuje všechny, hráč své a zveřejněné jen čte.
    match /characters/{id} {
      allow read: if isAdmin() || (isMember() && (resource.data.owner == me() || resource.data.public == true));
      allow create: if isMember() && request.resource.data.owner == me();
      allow update: if isAdmin() || (isMember() && resource.data.owner == me() && request.resource.data.owner == me());
      allow delete: if isAdmin() || (isMember() && resource.data.owner == me());

      // Zápisky: soukromé vidí jen autor, zveřejněné všichni členové.
      match /notes/{nid} {
        allow read: if isMember() && (resource.data.owner == me() || resource.data.public == true);
        allow create: if isMember() && request.resource.data.owner == me()
          && get(/databases/$(database)/documents/characters/$(id)).data.owner == me();
        allow update: if isMember() && resource.data.owner == me() && request.resource.data.owner == me();
        allow delete: if isMember() && resource.data.owner == me();
      }
    }

    // Knihovna kouzel a schopností. Přidávat může každý člen, upravovat autor a vypravěč.
    match /library/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.createdBy == me();
      allow update: if isAdmin() || (isMember() && resource.data.createdBy == me() && request.resource.data.createdBy == me());
      allow delete: if isAdmin() || (isMember() && resource.data.createdBy == me());
    }

    // Všechno ostatní je zavřené.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
